# ---------------------------------------------------------------------------
# API environment — copy to `.env` and adjust the values.
#
#   cp .env.example .env
#
# `.env` is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (prisma.config.ts) and by the
# runtime client (lib/prisma.ts, via the PrismaPg adapter).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taxpri"

# HTTP port. Optional; defaults to 4000 when unset.
PORT=4000
