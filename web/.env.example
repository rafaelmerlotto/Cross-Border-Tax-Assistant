# ---------------------------------------------------------------------------
# Web environment — copy to `.env` and adjust the value.
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed with `VITE_` to the browser bundle.
# `.env` is gitignored; set this variable in the hosting provider instead
# (for example in the Vercel project settings) for production deploys.
# ---------------------------------------------------------------------------

# Base URL of the API, with no trailing slash and no `/api` suffix.
VITE_API_URL=http://localhost:4000
